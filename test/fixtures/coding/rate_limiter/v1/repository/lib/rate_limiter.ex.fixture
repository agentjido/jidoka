defmodule RateLimiter do
  @moduledoc "A deterministic fixed-window rate limiter."

  @spec new(pos_integer(), pos_integer()) :: map()
  def new(limit, window_ms) do
    %{limit: limit, window_ms: window_ms, buckets: %{}}
  end

  @spec allow(map(), term(), non_neg_integer()) :: {:ok, map()} | {:error, :rate_limited, map()}
  def allow(limiter, _key, _now_ms) do
    {:ok, limiter}
  end
end
