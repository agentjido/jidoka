# Optional dotenv template for the Phoenix showcase app.
#
# ReqLLM loads .env from the current working directory by default in host apps.
# The Jidoka source config disables that behavior for package commands. Export
# provider keys in the shell for package live tests. The showcase runtime loads
# this file explicitly for local development.

# ReqLLM provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
